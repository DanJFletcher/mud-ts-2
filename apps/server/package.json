{
  "name": "@mudd/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_ENV=production node dist/index.js",
    "db:migrate:runtime": "node dist/db/migrate.js",
    "benchmark:db:readonly": "tsx src/read-only-db-benchmark.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@clerk/express": "^2.1.80",
    "@clerk/shared": "^4.40.0",
    "@mudd/client-sdk": "0.1.0",
    "@mudd/contracts": "0.1.0",
    "@mudd/core-plugins": "0.1.0",
    "@mudd/engine-core": "0.1.0",
    "@mudd/world-demo": "0.1.0",
    "@mudd/world-orraveth": "0.1.0",
    "drizzle-orm": "^0.44.0",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "express-ws": "^5.0.2",
    "pg": "^8.16.0",
    "zod": "^3.25.0"
  }
}
