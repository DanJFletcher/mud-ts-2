{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "allowJs": true
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "engine-contracts/**/*.ts",
    "scripts/**/*.ts",
    "*.ts",
    "packages/ui/.storybook/*.ts"
  ],
  "exclude": [
    "**/dist",
    "**/node_modules",
    "artifacts",
    "generated-artifacts"
  ]
}
